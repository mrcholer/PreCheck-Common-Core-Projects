#!/usr/bin/env python3
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
from prtest_core.cli import main  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.stderr.write("\nprtest: interrupted\n")
        os._exit(130)
